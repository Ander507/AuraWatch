# AuraWatch — paste keys comma-separated, rotator picks a working one
GEMINI_API_KEYS=your_key_1,your_key_2,your_key_3

# TMDB (https://www.themoviedb.org/settings/api) — watch provider logos
TMDB_API_KEY=
# Fallback only — users pick region in the UI (localStorage)
TMDB_WATCH_REGION=US

# IGDB / Twitch (https://api-docs.igdb.com/#account-creation) — Games format
# Create a Confidential Twitch app, then paste Client ID + Client Secret:
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=
# Aliases also accepted: TWITCH_CLIENT_ID / TWITCH_CLIENT_SECRET
