# AuraWatch — paste keys locally / in Vercel. NEVER commit real values.
# Copy to `.env` (gitignored) and fill in.

# Comma-separated Gemini keys — rotator picks a working one
GEMINI_API_KEYS=your_key_1,your_key_2

# TMDB (https://www.themoviedb.org/settings/api)
TMDB_API_KEY=
# Fallback region only — users pick their own in the UI
TMDB_WATCH_REGION=US

# IGDB / Twitch (https://api-docs.igdb.com/#account-creation)
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=

# Optional — BoardGameGeek XML API2 bearer token (https://boardgamegeek.com/applications)
# Without this, BGG search/covers often 401; typeahead falls back to a small local list
BGG_API_TOKEN=

# Optional — Upstash Redis shared cache
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Turso (libSQL) — use libsql://… from the Turso dashboard
TURSO_DB_URL=
TURSO_DB_AUTH_TOKEN=

# Auth.js — REQUIRED in production (openssl rand -hex 32)
AUTH_SECRET=
AUTH_TRUST_HOST=true
# Discord OAuth — callback: https://aurawatch.org/auth/callback/discord
AUTH_DISCORD_ID=
AUTH_DISCORD_SECRET=
